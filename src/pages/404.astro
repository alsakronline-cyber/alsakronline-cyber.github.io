---
import Layout from '../layouts/Layout.astro';
import { useT, href } from '../i18n';
const lang = 'en';
const t = useT(lang);
const ar = useT('ar');
---
<Layout lang={lang} title="404">
  <section class="container-x grid min-h-[80vh] place-items-center pt-24 text-center">
    <div>
      <p class="font-display text-[8rem] font-bold leading-none text-brand/30">404</p>
      <div class="chain-line mx-auto mt-2 w-48 rounded"></div>
      <h1 class="mt-8 text-3xl font-bold">{t.notFound.title}</h1>
      <p class="mt-3 text-muted">{t.notFound.text}</p>
      <p class="mt-1 text-muted" dir="rtl" lang="ar">{ar.notFound.text}</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href={href('en')} class="btn btn-primary">{t.notFound.home}</a>
        <a href={href('ar')} class="btn btn-ghost">{ar.notFound.home}</a>
      </div>
    </div>
  </section>
</Layout>
