---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import { useT, tr, href, langPaths, type Lang } from '../../../i18n';
import { posts } from '../../../data/posts';
import { media } from '../../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const fmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-EG-u-nu-latn' : 'en-GB', { dateStyle: 'long' });
---
<Layout lang={lang} title={t.nav.blog} description={t.blog.text} overlay>
  <PageHero eyebrow={t.nav.blog} title={t.blog.title} text={t.blog.text} video="spiral-classic" crumbs={[{ label: t.nav.home, href: href(lang) }, { label: t.nav.blog }]} />
  <section class="container-x grid gap-6 py-20 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((p, i) => (
      <a href={href(lang, `blog/${p.slug}`)} class="card card-hover group flex flex-col overflow-hidden" data-reveal style={`--d:${i * 100}ms`}>
        <div class="aspect-video overflow-hidden bg-black">
          <img src={media(p.video).poster} alt="" loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" />
        </div>
        <div class="flex flex-1 flex-col p-6">
          <p class="text-xs text-muted"><time datetime={p.date}>{fmt.format(new Date(p.date))}</time> · {p.minutes} {t.blog.minRead}</p>
          <h2 class="mt-3 text-xl font-bold leading-snug group-hover:text-brand">{tr(p.title, lang)}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{tr(p.excerpt, lang)}</p>
          <span class="mt-5 flex items-center gap-2 text-sm font-semibold text-brand">{t.actions.readMore}<Icon name="arrow" size={16} class="flip-rtl" /></span>
        </div>
      </a>
    ))}
  </section>
</Layout>
