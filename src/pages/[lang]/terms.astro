---
import Layout from '../../layouts/Layout.astro';
import { useT, tr, href, langPaths, type Lang } from '../../i18n';
import { legal } from '../../data/posts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const title = t.footer.terms;
---
<Layout lang={lang} title={title}>
  <article class="container-x max-w-3xl pb-10 pt-36">
    <nav aria-label="Breadcrumb" class="flex gap-2 text-sm text-muted"><a href={href(lang)} class="hover:text-brand">{t.nav.home}</a><span>/</span><span class="text-ink">{title}</span></nav>
    <h1 class="mt-6 text-4xl font-bold sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-muted">{t.legal.updated}: <time datetime={legal.updated}>{legal.updated}</time></p>
    <div class="prose-body mt-6">
      {legal.terms.map((b) => {
        const s = tr(b, lang);
        return s.startsWith('## ') ? <h2>{s.slice(3)}</h2> : <p>{s}</p>;
      })}
    </div>
  </article>
</Layout>
