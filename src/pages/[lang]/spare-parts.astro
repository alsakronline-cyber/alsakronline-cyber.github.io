---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { useT, tr, href, langPaths, type Lang } from '../../i18n';
import { spareParts } from '../../data/content';
import { waLink } from '../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const ask = (part: string) => waLink(lang === 'ar' ? `مرحبًا، أستفسر عن قطعة الغيار: ${part}` : `Hello, I am asking about the spare part: ${part}`);
const icons = ['chain', 'buffer', 'refresh', 'gear', 'gripper', 'pallet', 'belt', 'bolt', 'target'];
---
<Layout lang={lang} title={t.nav.spareParts} description={t.spare.text} overlay>
  <PageHero
    eyebrow={t.nav.spareParts}
    title={t.spare.title}
    text={t.spare.text}
    video="no-gap-chain"
    crumbs={[{ label: t.nav.home, href: href(lang) }, { label: t.nav.spareParts }]}
  />

  <section class="container-x py-20">
    <div class="mb-10 flex flex-col items-start justify-between gap-4 rounded-2xl border border-[#25d366]/40 bg-[#25d366]/10 p-6 sm:flex-row sm:items-center" data-reveal>
      <p class="flex items-center gap-3 font-medium"><Icon name="whatsapp" size={28} class="shrink-0 text-[#25d366]" />{t.spare.note}</p>
      <a href={ask(lang === 'ar' ? '(صورة مرفقة)' : '(photo attached)')} target="_blank" rel="noopener" class="btn bg-[#25d366] text-white">{t.actions.sendWhatsApp}</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {spareParts.map((s, i) => (
        <div class="card card-hover flex flex-col p-7" data-reveal style={`--d:${(i % 3) * 80}ms`}>
          <span class="grid size-12 place-items-center rounded-xl bg-brand-soft text-brand"><Icon name={icons[i]} size={24} /></span>
          <h2 class="mt-5 text-lg font-bold">{tr(s.name, lang)}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{tr(s.text, lang)}</p>
          <a href={ask(tr(s.name, lang))} target="_blank" rel="noopener" class="mt-5 flex items-center gap-2 text-sm font-semibold text-brand">
            {t.actions.askPart}<Icon name="arrow" size={16} class="flip-rtl" />
          </a>
        </div>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</Layout>
