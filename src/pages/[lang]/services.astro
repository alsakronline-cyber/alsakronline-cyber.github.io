---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { useT, tr, href, langPaths, type Lang } from '../../i18n';
import { services, process } from '../../data/content';
import { media } from '../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const ar = lang === 'ar';
const m = media('modular-belt');
---
<Layout lang={lang} title={t.nav.services} description={t.home.whatText} overlay>
  <PageHero
    eyebrow={t.nav.services}
    title={ar ? 'خدمات متكاملة لكل مرحلة من عمر الخط' : 'End-to-end services for every stage of your line'}
    text={t.home.whatText}
    video="modular-belt"
    crumbs={[{ label: t.nav.home, href: href(lang) }, { label: t.nav.services }]}
  />

  <section class="container-x py-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <div class="card card-hover group p-7" data-reveal style={`--d:${(i % 4) * 80}ms`}>
          <span class="grid size-12 place-items-center rounded-xl bg-brand-soft text-brand transition group-hover:bg-brand group-hover:text-white"><Icon name={s.icon} size={24} /></span>
          <h2 class="mt-5 text-lg font-bold">{tr(s.title, lang)}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">{tr(s.text, lang)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-bg-soft py-20">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow={ar ? 'الصيانة' : 'Maintenance'} title={ar ? 'عقود صيانة تحمي إنتاجك' : 'Maintenance contracts that protect your output'} text={ar ? 'زيارات وقائية مجدولة، وفحص للجنازير وشرائح التآكل ووحدات الإدارة، وتقارير حالة واضحة، واستجابة ذات أولوية عند الأعطال.' : 'Scheduled preventive visits, inspection of chains, wear strips and drives, clear condition reports and priority response for breakdowns.'} />
        <ul class="mt-6 space-y-3" data-reveal>
          {(ar
            ? ['زيارات وقائية شهرية أو ربع سنوية', 'مخزون قطع غيار مخصص لخطك', 'دعم فني عبر الهاتف وواتساب', 'تدريب فرق الصيانة لديك']
            : ['Monthly or quarterly preventive visits', 'Spare-parts stock reserved for your line', 'Phone and WhatsApp technical support', 'Training for your maintenance team']
          ).map((x) => <li class="flex items-center gap-3"><Icon name="check" size={18} class="text-brand" />{x}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <a href={href(lang, 'contact')} class="btn btn-primary">{t.actions.talk}</a>
          <a href={href(lang, 'spare-parts')} class="btn btn-ghost">{t.nav.spareParts}</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl bg-black" data-reveal>
        <video data-src={m.loop} data-autoplay muted loop playsinline preload="none" poster={m.poster} class="aspect-[4/3] w-full object-cover" aria-hidden="true"></video>
      </div>
    </div>
  </section>

  <section class="container-x py-20">
    <SectionHeading eyebrow={t.nav.services} title={t.home.processTitle} text={t.home.processText} />
    <ol class="mt-12 grid gap-4 md:grid-cols-5">
      {process.map((s, i) => (
        <li class="card p-6" data-reveal style={`--d:${i * 80}ms`}>
          <span class="font-display text-3xl font-bold text-brand">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-bold">{tr(s.title, lang)}</h3>
          <p class="mt-1 text-sm text-muted">{tr(s.text, lang)}</p>
        </li>
      ))}
    </ol>
  </section>

  <CtaBand lang={lang} />
</Layout>
