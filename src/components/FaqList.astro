---
import { tr, type Lang, type L } from '../i18n';

interface Props { lang: Lang; items: { q: L; a: L }[]; }
const { lang, items } = Astro.props;
---
<div class="divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface">
  {items.map((f, i) => (
    <details class="group" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-start text-lg font-semibold transition hover:text-brand [&::-webkit-details-marker]:hidden">
        {tr(f.q, lang)}
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-soft text-brand transition group-open:rotate-45">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </span>
      </summary>
      <p class="-mt-2 px-6 pb-6 leading-relaxed text-muted">{tr(f.a, lang)}</p>
    </details>
  ))}
</div>
