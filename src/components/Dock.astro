---
import Icon from './Icon.astro';
import { useT, href, type Lang } from '../i18n';
import { site, waLink } from '../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const hello = lang === 'ar' ? 'مرحبًا، أود الاستفسار عن أنظمة السيور.' : 'Hello, I would like to ask about your conveyor systems.';
---
<!-- Floating contact dock (desktop) -->
<div class="fixed bottom-6 end-5 z-40 hidden flex-col items-end gap-3 md:flex">
  <a href={`mailto:${site.email}`} class="dock-btn bg-surface text-ink" aria-label={t.actions.email}><Icon name="mail" /><span>{t.actions.email}</span></a>
  <a href={`tel:${site.phone}`} class="dock-btn bg-brand text-white" aria-label={t.actions.call}><Icon name="phone" /><span>{t.actions.call}</span></a>
  <a href={waLink(hello)} target="_blank" rel="noopener" class="dock-btn bg-[#25d366] text-white" aria-label={t.actions.whatsapp}><Icon name="whatsapp" size={24} /><span>{t.actions.whatsapp}</span></a>
</div>

<!-- Sticky action bar (mobile) -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-surface/95 text-xs font-semibold backdrop-blur md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href={`tel:${site.phone}`} class="flex flex-col items-center gap-1 py-2.5 text-ink"><Icon name="phone" />{t.actions.call}</a>
  <a href={waLink(hello)} target="_blank" rel="noopener" class="flex flex-col items-center gap-1 py-2.5 text-[#25d366]"><Icon name="whatsapp" />{t.actions.whatsapp}</a>
  <a href={href(lang, 'request-quotation')} class="flex flex-col items-center gap-1 bg-brand py-2.5 text-white"><Icon name="bolt" />{t.nav.quote}</a>
</div>

<style>
  .dock-btn {
    display: flex; align-items: center; gap: .6rem; height: 3.25rem; min-width: 3.25rem; padding-inline: 1rem;
    border-radius: 999px; box-shadow: 0 12px 30px -10px rgb(0 0 0 / .45); border: 1px solid var(--line);
    transition: transform .2s; font-weight: 600; font-size: .9rem;
  }
  .dock-btn span { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width .3s ease; }
  .dock-btn:hover { transform: translateY(-2px); }
  .dock-btn:hover span { max-width: 8rem; }
</style>
