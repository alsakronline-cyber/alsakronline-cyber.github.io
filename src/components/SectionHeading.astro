---
interface Props { eyebrow?: string; title: string; text?: string; center?: boolean; class?: string; }
const { eyebrow, title, text, center = false, class: cls = '' } = Astro.props;
---
<div class:list={['max-w-2xl', center && 'mx-auto text-center', cls]} data-reveal>
  {eyebrow && <span class:list={['eyebrow', center && 'justify-center']}>{eyebrow}</span>}
  <h2 class="mt-3 text-3xl font-bold sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">{title}</h2>
  {text && <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{text}</p>}
  <slot />
</div>
