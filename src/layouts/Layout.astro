---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import { useT, dir, switchPath, langs, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Header floats transparently over a full-bleed hero. */
  overlay?: boolean;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, overlay = false, image = '/media/showreel.webp', jsonLd } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} | ${t.brand}` : `${t.brand} — ${t.tagline}`;
const desc = description ?? t.home.heroText;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.brandLong,
  alternateName: [useT('en').brand, useT('ar').brand],
  url: Astro.site?.toString(),
  logo: new URL('/brand/logo.jpg', Astro.site).toString(),
  email: site.email,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', streetAddress: site.address.en, addressLocality: '10th of Ramadan City', addressCountry: 'EG' },
  sameAs: site.socials.map((s) => s.url),
};
---
<!doctype html>
<html lang={lang} dir={dir(lang)} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchPath(path, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchPath(path, 'en'), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#060d17" />
    <link rel="icon" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen pb-16 md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-[100] btn btn-primary">{t.skip}</a>
    <Header lang={lang} overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Dock lang={lang} />

    <dialog id="lightbox" class="m-auto w-[min(1100px,94vw)] bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm">
      <div class="relative">
        <button type="button" data-lightbox-close class="absolute -top-12 end-0 grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label={t.nav.close}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <video class="max-h-[80vh] w-full rounded-2xl bg-black" controls playsinline></video>
        <p data-lightbox-title class="mt-3 text-center text-sm text-white/80"></p>
      </div>
    </dialog>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
